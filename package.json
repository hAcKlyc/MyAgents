{
  "name": "myagents",
  "description": "MyAgents - Desktop Claude Code for everyone. AI-powered productivity, not just for developers.",
  "type": "module",
  "version": "0.5.11",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=11.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.14.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.15.0",
      "onFail": "error"
    }
  },
  "author": "MyAgents Team <myagents.io@gmail.com>",
  "homepage": "https://myagents.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hAcKlyc/MyAgents.git"
  },
  "bugs": {
    "url": "https://github.com/hAcKlyc/MyAgents/issues"
  },
  "keywords": [
    "claude",
    "ai",
    "agent",
    "desktop",
    "tauri",
    "productivity",
    "anthropic"
  ],
  "scripts": {
    "dev": "./start_dev.sh",
    "postinstall": "node scripts/verify-agent-network-protocol.mjs && node scripts/patch-codemirror-view.mjs && node scripts/patch-react-virtuoso.mjs && node scripts/patch-tauri-events.mjs",
    "predev:web": "node scripts/patch-codemirror-view.mjs --check && node scripts/patch-react-virtuoso.mjs --check && node scripts/patch-tauri-events.mjs --check",
    "dev:web": "vite",
    "prebuild:web": "node scripts/verify-agent-network-protocol.mjs && node scripts/patch-codemirror-view.mjs --check && node scripts/patch-react-virtuoso.mjs --check && node scripts/patch-tauri-events.mjs --check",
    "build:web": "npm run verify:license && vite build && npm run verify:theme-css && npm run verify:theme-presets",
    "build:server": "node scripts/esbuild-bundle.mjs server",
    "build:bridge": "node scripts/esbuild-bundle.mjs bridge",
    "build:cli": "node scripts/esbuild-bundle.mjs cli",
    "build:tsx-runtime": "node scripts/setup-tsx-runtime.mjs",
    "prepare:cuse": "node scripts/prepare-cuse-bundle.mjs",
    "prepare:native-inference": "node scripts/prepare-native-inference.mjs",
    "prepare:document-processing": "npm run prepare:native-inference",
    "server": "node --import tsx/esm src/server/index.ts",
    "start": "npm run build:web && npm run server",
    "tauri": "tauri",
    "tauri:dev": "node scripts/prepare-cliproxy.mjs && npm run prepare:native-inference && npm run verify:dsh-runtime && npm run verify:dsh-runtime:fresh && tauri dev",
    "tauri:build": "node scripts/integrated-runtimes/build-dsh-tauri.mjs",
    "tauri:build:prepared": "tauri build",
    "pretypecheck": "node scripts/verify-agent-network-protocol.mjs && node scripts/patch-codemirror-view.mjs --check && node scripts/patch-react-virtuoso.mjs --check && node scripts/patch-tauri-events.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location .eslintcache --max-warnings=0 && npm run lint:deps && npm run verify:agent-docs",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "test": "npm run test:classification && npm run test:build-scripts && npm run test:unit && npm run test:dom && npm run test:integration",
    "test:classification": "node scripts/check-test-classification.mjs",
    "test:linux-package": "node --test scripts/linux-package.test.mjs scripts/stage-claude-sdk-linux.test.mjs",
    "test:build-scripts": "node --test scripts/claude-sdk-macos-prepare.test.mjs scripts/macos-notarization.test.mjs scripts/build-resource-download.test.mjs scripts/npm-runtime-cache.test.mjs scripts/build-assets.test.mjs scripts/rust-build-cache.test.mjs scripts/package-cliproxy-component.test.mjs scripts/prepare-cliproxy.test.mjs scripts/patch-react-virtuoso.test.mjs scripts/patch-codemirror-view.test.mjs scripts/prepare-cuse-bundle.test.mjs scripts/node-runtime.test.mjs scripts/windows-node-runtime-install.test.mjs scripts/browser-runtime-packaging.test.mjs scripts/build-resource-staging.test.mjs scripts/cli-bundle-contract.test.mjs scripts/document-processing-build-tools.test.mjs scripts/document-processing-resource-cache.test.mjs scripts/package-speech-model-set.test.mjs scripts/prepare-native-inference.test.mjs scripts/prepare-speech-model-mirror.test.mjs scripts/server-bundle-browser-host.test.mjs scripts/sherpa-source-extraction.test.mjs scripts/speech-inference-resource-cache.test.mjs scripts/speech-quality-benchmark.test.mjs scripts/integrated-runtimes/dsh-handoff-policy.test.mjs scripts/integrated-runtimes/prepare-dsh-runtime.test.mjs scripts/server-bundle-dsh-web.test.mjs scripts/verify-agent-network-protocol.test.mjs scripts/verify-claude-sdk-wrapper.test.mjs scripts/patch-tauri-events.test.mjs scripts/tauri-event-lifecycle.test.mjs scripts/memory-skills.test.mjs",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:integration": "vitest run --project integration",
    "test:credentialed": "vitest run --project credentialed",
    "test:changed": "vitest run --changed --project unit --project dom --project integration",
    "test:watch": "vitest --project unit --project dom --project integration",
    "verify:chat-scroll": "node scripts/verify-chat-scroll.mjs",
    "verify:markdown-resize": "node scripts/verify-codemirror-resize.mjs",
    "verify:markdown-table-actions": "node scripts/verify-markdown-table-actions.mjs",
    "verify:theme-css": "node scripts/verify-theme-css.mjs",
    "verify:theme-presets": "vitest run --project unit src/renderer/theme/themes/preset-theme.test.ts --project dom src/renderer/theme/themes/preset-theme.registry.test.tsx",
    "verify:license": "node --test scripts/verify-license-contract-utils.test.mjs && node scripts/verify-license-contract.mjs",
    "verify:agent-docs": "node --test scripts/doc-links.test.mjs && node scripts/verify-agent-docs.mjs",
    "coverage": "vitest run --coverage --project unit --project dom --project integration",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check --log-level warn .",
    "generate:sdk-shims": "node --import tsx/esm scripts/generate-sdk-shims.ts",
    "package:managed-codex": "node scripts/package-managed-codex-runtime.mjs",
    "package:cliproxy": "node scripts/package-cliproxy-component.mjs",
    "verify:cliproxy:sdk-local": "node --import tsx scripts/verify-cliproxy-sdk-local.mjs",
    "verify:cliproxy-contract": "node scripts/verify-cliproxy-contract.mjs",
    "package:speech-model-set": "node scripts/package-speech-model-set.mjs",
    "publish:managed-codex": "./publish_managed_codex_runtime.sh",
    "publish:managed-codex:win": "powershell -ExecutionPolicy Bypass -File ./publish_managed_codex_runtime.ps1",
    "publish:speech-model-set": "./publish_speech_model_set.sh",
    "cache:rust": "node scripts/rust-build-cache.mjs",
    "clean:rust:app": "cargo clean --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target --profile dev -p myagents",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target",
    "clean": "rm -rf node_modules dist .turbo .eslintcache *.tsbuildinfo src-tauri/target",
    "version": "node scripts/sync-version.js && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml",
    "ingest:dsh-runtime": "node scripts/integrated-runtimes/ingest-dsh-handoff.mjs",
    "prepare:dsh-runtime": "node scripts/integrated-runtimes/prepare-dsh-runtime.mjs --source release",
    "verify:dsh-runtime": "node scripts/integrated-runtimes/verify-dsh-resources.mjs",
    "verify:dsh-runtime:fresh": "node scripts/integrated-runtimes/verify-dsh-dev-freshness.mjs",
    "build:assets": "npm run build:web && npm run build:server && npm run build:bridge && npm run build:cli",
    "build:sharp-runtime": "node scripts/prepare-sharp-runtime.mjs",
    "verify:agent-network-protocol": "node scripts/verify-agent-network-protocol.mjs",
    "test:native:tauri-events": "node scripts/verify-tauri-events.mjs",
    "test:native:quit": "node scripts/verify-native-quit.mjs"
  },
