{
  "name": "myagents",
  "description": "MyAgents - Desktop Claude Code for everyone. AI-powered productivity, not just for developers.",
  "type": "module",
  "version": "0.4.15",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "MyAgents Team <myagents.io@gmail.com>",
  "homepage": "https://myagents.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hAcKlyc/MyAgents.git"
  },
  "bugs": {
    "url": "https://github.com/hAcKlyc/MyAgents/issues"
  },
  "keywords": [
    "claude",
    "ai",
    "agent",
    "desktop",
    "tauri",
    "productivity",
    "anthropic"
  ],
  "scripts": {
    "dev": "./start_dev.sh",
    "dev:web": "vite",
    "build:web": "npm run verify:license && vite build && npm run verify:theme-css && npm run verify:theme-presets",
    "build:server": "node scripts/esbuild-bundle.mjs server",
    "build:bridge": "node scripts/esbuild-bundle.mjs bridge",
    "build:cli": "node scripts/esbuild-bundle.mjs cli",
    "build:tsx-runtime": "node scripts/setup-tsx-runtime.mjs",
    "prepare:native-inference": "node scripts/prepare-native-inference.mjs",
    "prepare:document-processing": "npm run prepare:native-inference",
    "server": "node --import tsx/esm src/server/index.ts",
    "start": "npm run build:web && npm run server",
    "tauri": "tauri",
    "tauri:dev": "npm run prepare:native-inference && tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location .eslintcache --max-warnings=0 && npm run lint:deps && npm run verify:agent-docs",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "test": "npm run test:classification && npm run test:build-scripts && npm run test:unit && npm run test:dom && npm run test:integration",
    "test:classification": "node scripts/check-test-classification.mjs",
    "test:build-scripts": "node --test scripts/node-runtime.test.mjs scripts/browser-runtime-packaging.test.mjs scripts/build-resource-staging.test.mjs scripts/cli-bundle-contract.test.mjs scripts/document-processing-build-tools.test.mjs scripts/document-processing-resource-cache.test.mjs scripts/package-speech-model-set.test.mjs scripts/prepare-native-inference.test.mjs scripts/prepare-speech-model-mirror.test.mjs scripts/server-bundle-browser-host.test.mjs scripts/sherpa-source-extraction.test.mjs scripts/speech-inference-resource-cache.test.mjs scripts/speech-quality-benchmark.test.mjs",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:integration": "vitest run --project integration",
    "test:credentialed": "vitest run --project credentialed",
    "test:changed": "vitest run --changed --project unit --project dom --project integration",
    "test:watch": "vitest --project unit --project dom --project integration",
    "verify:theme-css": "node scripts/verify-theme-css.mjs",
    "verify:theme-presets": "vitest run --project unit src/renderer/theme/themes/preset-theme.test.ts --project dom src/renderer/theme/themes/preset-theme.registry.test.tsx",
    "verify:license": "node --test scripts/verify-license-contract-utils.test.mjs && node scripts/verify-license-contract.mjs",
    "verify:agent-docs": "node scripts/verify-agent-docs.mjs",
    "coverage": "vitest run --coverage --project unit --project dom --project integration",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check --log-level warn .",
    "generate:sdk-shims": "node --import tsx/esm scripts/generate-sdk-shims.ts",
    "package:managed-codex": "node scripts/package-managed-codex-runtime.mjs",
    "package:speech-model-set": "node scripts/package-speech-model-set.mjs",
    "publish:managed-codex": "./publish_managed_codex_runtime.sh",
    "publish:managed-codex:win": "powershell -ExecutionPolicy Bypass -File ./publish_managed_codex_runtime.ps1",
    "publish:speech-model-set": "./publish_speech_model_set.sh",
    "clean": "rm -rf node_modules dist .turbo .eslintcache *.tsbuildinfo src-tauri/target",
    "version": "node scripts/sync-version.js && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.0.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@hono/node-server": "^2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/mcp": "0.0.68",
    "@tauri-apps/api": "~2.11",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tauri-apps/plugin-updater": "~2.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.16",
    "chart.js": "^4.4.7",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.13.0",
    "d3": "^7.9.0",
    "docx-preview": "^0.3.7",
    "i18next": "^26.3.3",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.27",
    "lucide": "^0.554.0",
    "lucide-react": "^0.554.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.7.284",
    "pinyin-pro": "^3.28.1",
    "playwright": "1.59.0-alpha-1771104257000",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.34.5",
    "socks": "^2.8.7",
    "undici": "^8.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.261",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.261",
    "@img/sharp-darwin-arm64": "*",
    "@img/sharp-darwin-x64": "*",
    "@img/sharp-linux-arm64": "*",
    "@img/sharp-linux-x64": "*",
    "@img/sharp-linuxmusl-arm64": "*",
    "@img/sharp-linuxmusl-x64": "*",
    "@img/sharp-win32-arm64": "*",
    "@img/sharp-win32-x64": "*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "~2.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.16",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
