{
  "productName": "MoX bot",
  "identifier": "com.moxbot.app",
  "app": {
    "security": {
      "assetProtocol": {
        "scope": [
          "$HOME/.moxbot/**"
        ]
      },
      "capabilities": [
        {
          "$schema": "../gen/schemas/desktop-schema.json",
          "identifier": "moxbot",
          "description": "Isolated MoX bot desktop permissions",
          "windows": [
            "main",
            "fb-ball",
            "fb-companion"
          ],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:window:allow-start-dragging",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-unminimize",
            "core:window:allow-is-maximized",
            "core:window:allow-is-fullscreen",
            "core:window:allow-set-focus",
            "core:window:allow-is-visible",
            "core:window:allow-is-focused",
            "core:window:allow-set-background-color",
            "fs:default",
            "fs:allow-app-read-recursive",
            "fs:allow-app-write-recursive",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$HOME/.moxbot"
                },
                {
                  "path": "$HOME/.moxbot/**"
                }
              ]
            },
            "dialog:default",
            "dialog:allow-open",
            "dialog:allow-save",
            {
              "identifier": "dialog:allow-open",
              "allow": [
                {
                  "directory": true
                }
              ]
            },
            "shell:allow-open",
            "process:allow-restart",
            "notification:allow-is-permission-granted",
            "autostart:default",
            "autostart:allow-is-enabled",
            "autostart:allow-enable",
            "autostart:allow-disable",
            "global-shortcut:allow-register",
            "global-shortcut:allow-unregister",
            "global-shortcut:allow-is-registered"
          ]
        }
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "resources": {
      "infoplist/en.lproj/InfoPlist.strings": null,
      "infoplist/moxbot/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "infoplist/zh-Hans.lproj/InfoPlist.strings": null,
      "infoplist/moxbot/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings"
    },
    "macOS": {
      "infoPlist": "Info.moxbot.plist",
      "signingIdentity": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "moxbot"
        ]
      }
    }
  }
}
